    "agents",
    "agents.md",
    "ai-agents",
    "documentation",
    "linter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dropout-developer/decisions.md.git"
  },
  "bugs": {
    "url": "https://github.com/dropout-developer/decisions.md/issues"
  },
  "homepage": "https://github.com/dropout-developer/decisions.md#readme",
